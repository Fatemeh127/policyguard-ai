# OpenAI
OPENAI_API_KEY=sk-proj-replace-with-your-openai-key

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=policyguard_docs


# Redis
REDIS_URL=redis://localhost:6380

# App Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_DEBUG=false

# Cost Settings (per million tokens)
COST_EMBEDDING_PER_M=0.02
COST_INPUT_PER_M=0.50
COST_OUTPUT_PER_M=1.50

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_password_here
GRAFANA_ALLOW_SIGNUP=false

# Security(authentication)
SECRET_KEY=change-this-secret-key-at-least-32-chars
API_AUTH_ENABLED=true
EMPLOYEE_API_KEY=replace-with-employee-key
MANAGER_API_KEY=replace-with-manager-key
ADMIN_API_KEY=replace-with-admin-key

# Embedding Settings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
